{
  "env": {
    "ENABLE_LSP_TOOL": "1"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "blockOnError": true,
            "command": "uv run ruff check --fix --unfixable F401 --quiet ."
          },
          {
            "type": "command",
            "blockOnError": true,
            "command": "uv run black --quiet --target-version py312 ."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run scripts/verify.py",
            "blockOnError": true,
            "statusMessage": "Running verification before finishing..."
          },
          {
            "type": "command",
            "command": "uv run scripts/translate.py",
            "blockOnError": true,
            "statusMessage": "Running translate before finishing..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "commit-commands@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  }
}

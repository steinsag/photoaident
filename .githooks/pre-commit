#!/usr/bin/env bash
# Git pre-commit hook: run linting, format and type checks via uv
# This hook requires `uv` to be installed and available on PATH.
# It blocks the commit if any check fails.

set -euo pipefail

require_uv() {
  if ! command -v uv >/dev/null 2>&1; then
    echo "[pre-commit] Error: 'uv' is not installed or not on PATH." >&2
    echo "- Install uv: https://github.com/astral-sh/uv#installation" >&2
    echo "- Then install dev dependencies: uv sync" >&2
    return 127
  fi
}

run_ruff_check() {
  echo "[pre-commit] Linting with Ruff..."
  uv run ruff check .
}

run_black_check() {
  echo "[pre-commit] Checking code formatting with Black..."
  uv run black --check .
}

run_pyright_check() {
  echo "[pre-commit] Running static type checks with pyright..."
  uv run pyright --pythonversion 3.12 src/ tests/
}

run_ty_check() {
  echo "[pre-commit] Running static type checks with ty..."
  uv run ty check
}

run_translation_check() {
  echo "[pre-commit] Checking if translations (*.ts) are up-to-date..."
  ts_files="assets/translations/photoaident_de.ts assets/translations/photoaident_en.ts"
  # -locations none: omit <location> tags so .ts files are stable across
  #   code reformats (only change when strings are added/removed).
  # -extensions py: directory scan must be told to look at .py files
  #   (lupdate's default extension list does not include Python).
  uv run pyside6-lupdate -locations none -extensions py src/ -ts $ts_files > /dev/null
  if ! git diff --exit-code $ts_files > /dev/null; then
    echo "[pre-commit] Translation files are out of date — lupdate found new or removed strings."
    echo "Stage the updated files and commit them:"
    echo "  git add $ts_files"
    return 1
  fi
}

# Ensure uv is available
require_uv

# Run checks
if ! run_translation_check; then
  exit 1
fi

if ! run_black_check; then
  echo
  echo "[pre-commit] Black formatting check failed. Please format your code and try again."
  echo "You can auto-format with: uv run black ."
  exit 1
fi

if ! run_ruff_check; then
  echo
  echo "[pre-commit] Ruff linting failed. Please fix the reported issues and try again."
  echo "You can run locally with: uv run ruff check ."
  exit 1
fi

if ! run_pyright_check; then
  echo
  echo "[pre-commit] pyright check failed. Please fix type errors and try again."
  echo "You can run locally with: uv run pyright --pythonversion 3.12 src/ tests/"
  exit 1
fi

if ! run_ty_check; then
  echo
  echo "[pre-commit] ty check failed. Please fix type errors and try again."
  echo "You can run locally with: uv run ty check"
  exit 1
fi

exit 0
